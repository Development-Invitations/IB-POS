{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IB-POS",
  "version": "0.1.0",
  "identifier": "com.ibpos.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IB-POS",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBQzAxNjlBN0MxODZBMApSV1NnaHNHbmFRR3NEWXdJL2F5T09DM1NLWWpiWnppVmo1K3hDTkJRVExYNHJZZ1NHY0VQTFZoMwo=",
      "endpoints": [
        "https://github.com/Development-Invitations/IB-POS/releases/latest/download/latest.json"
      ]
    }
  }
}
